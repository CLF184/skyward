# Skyward's own OMAPI service.
#
# A phone whose weaver HAL is Thales reaches the secure element through
# Android's OMAPI service, which lives in system_server. A recovery runs no
# framework, so the weaver's every call is answered by nothing, and a user's
# secret kept behind a weaver slot cannot be read. This program is that
# service on its own: it registers the same name, and hands the weaver's
# traffic to the secure element HAL, which the stock recovery starts.
#
# Started at late-init, before the recovery itself: the weaver asks it the
# moment a call comes in, and the eSE HAL registers on its own schedule.
#
# The libraries beside it in system/lib64 are the ones it loads; LD_LIBRARY_PATH
# names the ramdisk's own folder first, because a recovery's linker otherwise
# searches the stock vendor tree the installed system left on the phone, whose
# libbinder is a different build.
service skyward-omapi /system/bin/se_omapi
    class core
    user root
    group root system
    setenv LD_LIBRARY_PATH /system/lib64:/system/lib64/hw
    seclabel u:r:recovery:s0
    disabled

on late-init
    start skyward-omapi
